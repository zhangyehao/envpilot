command_exists()
{
    command -v "$1" >/dev/null 2>&1
}

envpilot_secret_file_mode()
{
    stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1" 2>/dev/null || true
}

envpilot_secret_file_is_safe()
{
    local secret_file="$1" mode owner_uid current_uid
    [ -f "$secret_file" ] || return 1
    current_uid="$(id -u)"
    owner_uid="$(stat -c '%u' "$secret_file" 2>/dev/null || stat -f '%u' "$secret_file" 2>/dev/null || printf '%s' "$current_uid")"
    [ "$owner_uid" = "$current_uid" ] || return 1
    mode="$(envpilot_secret_file_mode "$secret_file")"
    case "$mode" in
        400|600) return 0 ;;
        *) return 1 ;;
    esac
}

envpilot_load_protected_environment()
{
    local secret_file="${1:-$BASHRC_SECRETS_FILE}"
    local allexport_was_set=0 status=0
    envpilot_secret_file_is_safe "$secret_file" || return 1
    case $- in
        *a*) allexport_was_set=1 ;;
        *) set -a ;;
    esac
    # api.env is a user-owned shell environment file, protected by owner/mode checks.
    # shellcheck disable=SC1090
    . "$secret_file" >/dev/null 2>&1 || status=$?
    [ "$allexport_was_set" = "1" ] || set +a
    return "$status"
}

envpilot_shell_local_value()
{
    local key="${1:-}"
    local line value result=""
    [ -r "$BASHRC_LOCAL_FILE" ] || return 1
    while IFS= read -r line || [ -n "$line" ]; do
        while :; do
            case "$line" in
                [[:space:]]*) line="${line#?}" ;;
                *) break ;;
            esac
        done
        case "$line" in
            export[[:space:]]*)
                line="${line#export}"
                while :; do
                    case "$line" in
                        [[:space:]]*) line="${line#?}" ;;
                        *) break ;;
                    esac
                done
                ;;
        esac
        case "$line" in
            "$key="*) value="${line#*=}" ;;
            *) continue ;;
        esac
        while :; do
            case "$value" in
                *[[:space:]]) value="${value%?}" ;;
                *) break ;;
            esac
        done
        case "$value" in
            \"*\") value="${value#\"}"; value="${value%\"}" ;;
            \'*\') value="${value#\'}"; value="${value%\'}" ;;
        esac
        case "$value" in
            ''|*[!A-Za-z0-9_./:@+-]*) continue ;;
            *) result="$value" ;;
        esac
    done < "$BASHRC_LOCAL_FILE"
    [ -n "$result" ] || return 1
    printf '%s\n' "$result"
}

