path_contains()
{
    case ":${PATH:-}:" in
        *":$1:"*) return 0 ;;
        *) return 1 ;;
    esac
}

path_prepend()
{
    [ -d "$1" ] || return 0
    path_contains "$1" || PATH="$1${PATH:+:$PATH}"
    export PATH
}

path_append()
{
    [ -d "$1" ] || return 0
    path_contains "$1" || PATH="${PATH:+$PATH:}$1"
    export PATH
}

