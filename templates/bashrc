}

mihomo_stop()
{
    [ -x "$BASHRC_MIHOMO_STOP_SCRIPT" ] || {
        printf 'Mihomo stop script not found: %s\n' "$BASHRC_MIHOMO_STOP_SCRIPT" >&2
