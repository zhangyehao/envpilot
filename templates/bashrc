init_environment_modules()
{
    if type module >/dev/null 2>&1; then
        return 0
    fi
    local candidate
    for candidate in \
        /etc/profile.d/modules.sh \
        /usr/share/Modules/init/bash \
        /usr/share/lmod/lmod/init/bash \
        /opt/modules/init/bash; do
        if [ -r "$candidate" ]; then
            . "$candidate"
            break
        fi
    done
}

hpc_modules_load()
{
    [ -r "$HOME/.config/envpilot/modules.list" ] || return 0
    init_environment_modules
    type module >/dev/null 2>&1 || return 0
    while IFS= read -r module_name; do
        case "$module_name" in ''|'#'*) continue ;; esac
        module load "$module_name" || return 1
    done < "$HOME/.config/envpilot/modules.list"
}

envpilot_conda_env_dir_add()
{
    local dir="${1:-}"
    [ -n "$dir" ] || return 0
    case ":${CONDA_ENVS_PATH:-}:" in
        *":$dir:"*) ;;
        *) CONDA_ENVS_PATH="${CONDA_ENVS_PATH:+$CONDA_ENVS_PATH:}$dir" ;;
    esac
}

envpilot_conda_configure_env_dirs()
{
    local primary="${1:-}"
    local candidate inherited item
    inherited="${CONDA_ENVS_PATH:-}"
    unset CONDA_ENVS_PATH

    for candidate in \
        "$primary/envs" \
        "$HOME/software/miniconda3/envs" \
        "$HOME/miniconda3/envs" \
        "$HOME/software/anaconda3/envs" \
        "$HOME/anaconda3/envs" \
        "$HOME/.conda/envs"; do
        [ -n "$candidate" ] || continue
        [ -d "$candidate" ] || continue
        envpilot_conda_env_dir_add "$candidate"
    done

    while [ -n "$inherited" ]; do
        case "$inherited" in
            *:*) item="${inherited%%:*}"; inherited="${inherited#*:}" ;;
            *) item="$inherited"; inherited="" ;;
        esac
        envpilot_conda_env_dir_add "$item"
    done

    if [ -n "${CONDA_ENVS_PATH:-}" ]; then
        export CONDA_ENVS_PATH
    fi
}

envpilot_conda_prefix()
{
    local candidate
    for candidate in \
        "${BASHRC_CONDA_PRIMARY_PREFIX:-}" \
        "$HOME/software/miniconda3" \
        "$HOME/miniconda3" \
        "$HOME/software/anaconda3" \
        "$HOME/anaconda3" \
        /opt/conda; do
        [ -n "$candidate" ] || continue
        [ -r "$candidate/etc/profile.d/conda.sh" ] || continue
        printf '%s' "$candidate"
        return 0
    done
    return 1
}

envpilot_prepare_conda_prefix()
{
    local prefix="$1"
    unset -f conda 2>/dev/null || true
    unfunction conda 2>/dev/null || true
    unset CONDA_EXE CONDA_PYTHON_EXE CONDA_PREFIX CONDA_DEFAULT_ENV \
        CONDA_PROMPT_MODIFIER CONDA_SHLVL
    path_prepend "$prefix/condabin"
    path_prepend "$prefix/bin"
    hash -r 2>/dev/null || rehash 2>/dev/null || true
    envpilot_conda_configure_env_dirs "$prefix"
    # shellcheck disable=SC1090,SC1091
    . "$prefix/etc/profile.d/conda.sh"
}

init_conda()
{
    local prefix
    if prefix="$(envpilot_conda_prefix 2>/dev/null)"; then
        envpilot_prepare_conda_prefix "$prefix"
        return $?
    fi
    type conda >/dev/null 2>&1
}

