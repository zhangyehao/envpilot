envpilot_shell_local_value()
{
    local key="${1:-}"
    local line value result=""
    [ -r "$ENVPILOT_CONFIG_DIR/shell.local" ] || return 1
    while IFS= read -r line || [ -n "$line" ]; do
        while :; do
            case "$line" in
                [[:space:]]*) line="${line#?}" ;;
                *) break ;;
            esac
        done
        case "$line" in
            export[[:space:]]*)
                line="${line#export}"
                while :; do
                    case "$line" in
                        [[:space:]]*) line="${line#?}" ;;
                        *) break ;;
                    esac
                done
                ;;
        esac
        case "$line" in
            "$key="*) value="${line#*=}" ;;
            *) continue ;;
        esac
        while :; do
            case "$value" in
                *[[:space:]]) value="${value%?}" ;;
                *) break ;;
            esac
        done
        case "$value" in
            \"*\") value="${value#\"}"; value="${value%\"}" ;;
            \'*\') value="${value#\'}"; value="${value%\'}" ;;
        esac
        case "$value" in
            ''|*[!A-Za-z0-9_./:@+-]*) continue ;;
            *) result="$value" ;;
        esac
    done < "$ENVPILOT_CONFIG_DIR/shell.local"
    [ -n "$result" ] || return 1
    printf '%s\n' "$result"
}

