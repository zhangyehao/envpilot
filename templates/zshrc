proxy_no_proxy_add()
{
    local value="${1:-}"
    [ -n "$value" ] || return 0
    no_proxy="${no_proxy:-${NO_PROXY:-}}"
    case ",${no_proxy:-}," in
        *",$value,"*) ;;
        *) no_proxy="${no_proxy:+$no_proxy,}$value" ;;
    esac
    export no_proxy
    export NO_PROXY="$no_proxy"
}

proxy_port_socket_listening()
{
    local port="${1:-$MIHOMO_PROXY_PORT}"
    local line
    if command_exists ss; then
        line="$(ss -lntH "sport = :$port" 2>/dev/null | head -n 1 || true)"
        [ -n "$line" ] && return 0
    fi
    if command_exists lsof; then
        line="$(lsof -nP -iTCP:"$port" -sTCP:LISTEN 2>/dev/null | awk 'NR == 2 { print; exit }' || true)"
        [ -n "$line" ] && return 0
    fi
    if command_exists netstat; then
        line="$(netstat -an 2>/dev/null | grep -E "[.:]${port}[[:space:]].*LISTEN" | head -n 1 || true)"
        [ -n "$line" ] && return 0
    fi
    return 1
}

proxy_port_is_listening()
{
    local host="${1:-$MIHOMO_PROXY_HOST}"
    local port="${2:-$MIHOMO_PROXY_PORT}"
    proxy_port_socket_listening "$port" && return 0
    if command_exists nc && nc -z -w 1 "$host" "$port" >/dev/null 2>&1; then
        return 0
    fi
    if command_exists timeout && timeout 1 bash -c ": </dev/tcp/$host/$port" >/dev/null 2>&1; then
        return 0
    fi
    return 1
}

envpilot_prepare_noninteractive_proxy()
{
    [ "${BASHRC_PROXY_PRESTART_NONINTERACTIVE:-1}" = "1" ] || return 1
    [ -x "$BASHRC_MIHOMO_START_SCRIPT" ] || return 1
    [ -s "$HOME/.config/mihomo/config.yaml" ] || return 1
    proxy_port_is_listening "$MIHOMO_PROXY_HOST" "$MIHOMO_PROXY_PORT" && return 0
    (
        unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY all_proxy ALL_PROXY
        export no_proxy="127.0.0.1,localhost,::1"
        export NO_PROXY="$no_proxy"
        MIHOMO_PROXY_PORT="$MIHOMO_PROXY_PORT" \
            MIHOMO_API_PORT="$MIHOMO_API_PORT" \
            MIHOMO_QUIET_START=1 \
            "$BASHRC_MIHOMO_START_SCRIPT"
    ) >/dev/null 2>&1 || return 1
    proxy_port_is_listening "$MIHOMO_PROXY_HOST" "$MIHOMO_PROXY_PORT"
}

envpilot_export_proxy_if_ready()
{
    proxy_port_is_listening "$MIHOMO_PROXY_HOST" "$MIHOMO_PROXY_PORT" || return 0
    export http_proxy="http://${MIHOMO_PROXY_HOST}:${MIHOMO_PROXY_PORT}"
    export https_proxy="$http_proxy"
    export HTTP_PROXY="$http_proxy"
    export HTTPS_PROXY="$https_proxy"
    if [ "$BASHRC_PROXY_ENABLE_SOCKS" = "1" ]; then
        export all_proxy="socks5h://${MIHOMO_PROXY_HOST}:${MIHOMO_PROXY_PORT}"
        export ALL_PROXY="$all_proxy"
    else
        unset all_proxy ALL_PROXY
    fi
    proxy_no_proxy_add localhost
    proxy_no_proxy_add 127.0.0.1
    proxy_no_proxy_add ::1
}

envpilot_prepare_noninteractive_environment()
{
    if envpilot_prepare_noninteractive_proxy; then
        envpilot_export_proxy_if_ready
    fi
}

# No real TTY: keep only the minimal environment.
