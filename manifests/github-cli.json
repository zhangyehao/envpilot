{
  "name": "github-cli",
  "source": "https://github.com/cli/cli/releases",
  "api": "https://api.github.com/repos/cli/cli/releases",
  "stable_policy": "Select stable release assets, excluding alpha, beta, rc, and pre.",
  "asset_rules": [
    { "os": "linux", "arch": "amd64", "regex": "gh_.*_linux_amd64\\.tar\\.gz$" },
    { "os": "linux", "arch": "arm64", "regex": "gh_.*_linux_arm64\\.tar\\.gz$" },
    { "os": "darwin", "arch": "amd64", "regex": "gh_.*_macOS_amd64\\.zip$" },
    { "os": "darwin", "arch": "arm64", "regex": "gh_.*_macOS_arm64\\.zip$" },
    { "os": "windows", "arch": "amd64", "winget_id": "GitHub.cli" }
  ],
  "auth": {
    "preferred_git_protocol": "ssh",
    "command": "gh auth login -h github.com --git-protocol ssh"
  }
}

